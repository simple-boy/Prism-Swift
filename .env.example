# Copy to .env and generate your own dedicated API key. No model key is required.
MEMORY_API_KEY=
PRODUCTION=1
SYSTEM_VERSION=0.1.0
SOURCE_COMMIT=unfixed
IMAGE_TAG=0.1.0
STRATEGY=adaptive

# New independent service; do not reuse the existing 8002 container or its volume.
BIND_HOST=0.0.0.0
PUBLIC_PORT=8003
MEMORY_DB_PATH=/app/data/swift.sqlite3
MAX_ADD_CONCURRENCY=2
MAX_SEARCH_CONCURRENCY=2
CPU_LIMIT=1.5
MEMORY_LIMIT=1024m

# Explicit service capacity; image byte limits follow the official contract.
MAX_REQUEST_BYTES=67108864
MAX_RESPONSE_BYTES=67108864
MAX_IMAGE_BYTES=10485760
MAX_MEDIA_BYTES=31457280
MAX_IMAGE_PIXELS=16000000
MAX_RESULTS=100
MIN_FREE_BYTES=1073741824
READ_TIMEOUT_SECONDS=120

# Public package mirrors only; no credentials in build arguments.
PYTHON_IMAGE=python:3.11-slim-bookworm
SWIFT_PIP_INDEX=https://pypi.org/simple

# Default contains no torch/transformers. Optional Industrial configuration only.
VISUAL_RERANKER=none
RERANKER_THREADS=2
RERANKER_CANDIDATES=32
