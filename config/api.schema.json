{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:prism-swift:participant-api-shapes:v1",
  "title": "Participant-side AML API shapes, not an official schema publication",
  "description": "Runtime additionally checks decoded media, image authenticity, UTF-8 byte capacities, persistence and isolation. See docs/competition_contract.md.",
  "$defs": {
    "id": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "text": {"type": "object", "required": ["type", "text"], "properties": {"type": {"const": "text"}, "text": {"type": "string", "minLength": 1, "pattern": "\\S"}}},
    "image": {"type": "object", "required": ["type", "image_url"], "properties": {
      "type": {"const": "image_url"}, "image_url": {"type": "object", "required": ["url"], "properties": {
        "url": {"type": "string", "minLength": 1, "description": "Inline Base64 JPEG/PNG/WebP only; no remote URL."}
      }}
    }},
    "content": {"oneOf": [
      {"type": "string", "minLength": 1, "pattern": "\\S"},
      {"type": "array", "minItems": 1, "items": {"oneOf": [{"$ref": "#/$defs/text"}, {"$ref": "#/$defs/image"}]}}
    ]},
    "message": {"type": "object", "required": ["role", "content"], "properties": {
      "role": {"enum": ["user", "assistant"]}, "content": {"$ref": "#/$defs/content"},
      "timestamp": {"type": "integer", "description": "Unix milliseconds, omitted when absent; null is rejected."}
    }},
    "add_request": {"type": "object", "required": ["request_id", "user_id", "session_id", "messages"], "properties": {
      "request_id": {"$ref": "#/$defs/id"}, "user_id": {"$ref": "#/$defs/id"}, "session_id": {"$ref": "#/$defs/id"},
      "messages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/message"}}
    }},
    "add_response": {"type": "object", "required": ["success", "request_id", "user_id", "session_id"], "properties": {
      "success": {"const": true}, "request_id": {"$ref": "#/$defs/id"}, "user_id": {"$ref": "#/$defs/id"}, "session_id": {"$ref": "#/$defs/id"}
    }},
    "search_request": {"type": "object", "required": ["user_id", "query", "top_k"], "properties": {
      "user_id": {"$ref": "#/$defs/id"}, "query": {"$ref": "#/$defs/content"},
      "top_k": {"type": "integer", "minimum": 1, "maximum": 100},
      "options": {"type": "array", "items": {"type": "string", "minLength": 1, "pattern": "\\S"}}
    }},
    "search_response": {"type": "object", "required": ["data"], "properties": {
      "data": {"type": "array", "maxItems": 100, "items": {"type": "object", "required": ["id", "content"], "properties": {
        "id": {"$ref": "#/$defs/id"}, "content": {"$ref": "#/$defs/content"}, "score": {"type": "number"}, "created_at": {"type": "string", "format": "date-time"}
      }}}
    }},
    "error": {"type": "object", "required": ["detail"], "properties": {
      "detail": {"type": "object", "required": ["reason"], "properties": {"reason": {"type": "string"}}}
    }}
  }
}
